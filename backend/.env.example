# AUTH-01B — Suecão Account auth (not multiplayer guest JWT)
DATABASE_URL=postgres://suecao:suecao@127.0.0.1:5433/suecao_auth
JWT_SIGNING_KEY=dev-account-signing-key-change-me
# Existing multiplayer guest JWT secret (unchanged semantics)
JWT_SECRET=dev-change-in-production
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL_DAYS=60
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
# Comma-separated. Prefer CORS_ORIGINS; ALLOWED_ORIGINS still supported for MP.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,capacitor://localhost,https://localhost
ALLOWED_ORIGINS=http://localhost:3000,capacitor://localhost,https://localhost
PORT=8787
