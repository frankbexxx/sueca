# Suecão frontend env (Vite). Copy to .env.local as needed.
# VITE_CARD_EXT=png   # svg or png after map-card-pack
VITE_USE_LOCAL_AI_ONLY=true
VITE_PLATFORM=web

# Multiplayer / Firebase
VITE_MULTIPLAYER_ENABLED=false
# VITE_DEBUG_MP=true
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_DATABASE_URL=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=

# Ads
VITE_ADS_ENABLED=false
VITE_GAMES_PER_AD=20

# Remote AI service (optional)
# VITE_AI_SERVICE_URL=https://your-api.example.com

# Card Intelligence debug (dev)
# VITE_CARD_INTELLIGENCE_DEBUG=true
# VITE_CARD_INTELLIGENCE_LLM_ADVISORY=true
# VITE_CARD_INTELLIGENCE_LLM_PROVIDER=mock
# VITE_CARD_INTELLIGENCE_LLM_ENDPOINT=http://localhost:11434
# VITE_CARD_INTELLIGENCE_LLM_MODEL=llama3.2:3b
