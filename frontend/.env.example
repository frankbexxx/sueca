# Web / Vercel
# REACT_APP_CARD_EXT=png   # svg (default) or png after map-card-pack
REACT_APP_USE_LOCAL_AI_ONLY=true
REACT_APP_PLATFORM=web

# Android: see .env.android — npm run build:android sets these inline

# Multiplayer (Firebase RTDB — see docs/FIREBASE_MULTIPLAYER.md)
REACT_APP_MULTIPLAYER_ENABLED=false
# REACT_APP_DEBUG_MP=true
# REACT_APP_FIREBASE_API_KEY=
# REACT_APP_FIREBASE_DATABASE_URL=
# REACT_APP_FIREBASE_PROJECT_ID=
# REACT_APP_FIREBASE_APP_ID=

# Monetization (off in dev)
REACT_APP_ADS_ENABLED=false
REACT_APP_GAMES_PER_AD=20

# External AI (disabled when USE_LOCAL_AI_ONLY=true)
# REACT_APP_AI_SERVICE_URL=https://your-api.example.com

# Card Intelligence — Mini-LLM advisory (debug only; default OFF)
# REACT_APP_CARD_INTELLIGENCE_DEBUG=true
# REACT_APP_CARD_INTELLIGENCE_LLM_ADVISORY=true
# REACT_APP_CARD_INTELLIGENCE_LLM_PROVIDER=mock
# REACT_APP_CARD_INTELLIGENCE_LLM_ENDPOINT=http://localhost:11434
# REACT_APP_CARD_INTELLIGENCE_LLM_MODEL=llama3.2:3b
# Ollama CORS for browser dev: OLLAMA_ORIGINS=* ollama serve
