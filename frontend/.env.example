# Suecão frontend env (Vite). Copy to .env.local / mode files as needed.
# VITE_CARD_EXT=png   # svg or png after map-card-pack
VITE_USE_LOCAL_AI_ONLY=true
VITE_PLATFORM=web

# Multiplayer / Firebase
# When VITE_MULTIPLAYER_ENABLED=true, the four VITE_FIREBASE_* vars below are required
# (Firebase *web client* config — public in the JS bundle; not service-account secrets).
# Security for RTDB is enforced by Firebase Security Rules, not by hiding these values.
VITE_MULTIPLAYER_ENABLED=false
# VITE_DEBUG_MP=true
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_DATABASE_URL=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=

# Ads
VITE_ADS_ENABLED=false
VITE_GAMES_PER_AD=20

# Remote AI service (optional)
# VITE_AI_SERVICE_URL=https://your-api.example.com

# AUTH-01C/D — optional Suecão Account / Google sign-in
# Guest play works without these. Do not commit client secrets.
# VITE_GOOGLE_WEB_CLIENT_ID=your-web-client.apps.googleusercontent.com
# Android OAuth client (package com.suecao.cardgames + debug/release SHA-1) — NOT the Web client:
# VITE_GOOGLE_ANDROID_CLIENT_ID=your-android-client.apps.googleusercontent.com
# Production: HTTPS Account API only.
# VITE_AUTH_API_BASE_URL=https://auth.example.com
# Local OPPO LAN smoke only (HTTP): set LAN IP, then sync with mixed-content opt-in:
#   VITE_AUTH_API_BASE_URL=http://192.168.x.x:8787
#   SUECAO_ANDROID_ALLOW_MIXED_CONTENT=true npm run cap:sync:android:lan
# Cleartext is debug-build-only (see scripts/apply-android-debug-cleartext.mjs).

# Remote music catalog (optional). Omit to keep remotes disabled (core fallback).
# *.r2.dev is smoke/dev only — not the final production CDN contract.
# VITE_MUSIC_REMOTE_BASE_URL=https://pub-xxxxxxxx.r2.dev
# VITE_MUSIC_REMOTE_SMOKE=true

# Card Intelligence debug (dev)
# VITE_CARD_INTELLIGENCE_DEBUG=true
# VITE_CARD_INTELLIGENCE_LLM_ADVISORY=true
# VITE_CARD_INTELLIGENCE_LLM_PROVIDER=mock
# VITE_CARD_INTELLIGENCE_LLM_ENDPOINT=http://localhost:11434
# VITE_CARD_INTELLIGENCE_LLM_MODEL=llama3.2:3b
