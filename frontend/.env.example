# Web / Vercel
# REACT_APP_CARD_EXT=png   # svg (default) or png after map-card-pack
REACT_APP_USE_LOCAL_AI_ONLY=true
REACT_APP_PLATFORM=web

# Android: see .env.android — npm run build:android sets these inline

# Multiplayer (off until backend v1 deployed)
REACT_APP_MULTIPLAYER_ENABLED=false
# REACT_APP_MULTIPLAYER_URL=wss://api.example.com/ws

# Monetization (off in dev)
REACT_APP_ADS_ENABLED=false
REACT_APP_GAMES_PER_AD=20

# External AI (disabled when USE_LOCAL_AI_ONLY=true)
# REACT_APP_AI_SERVICE_URL=https://your-api.example.com
