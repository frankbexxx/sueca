{
  "name": "sueca-frontend",
  "version": "0.1.0-beta",
  "private": true,
  "type": "module",
  "dependencies": {
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/preferences": "^6.0.3",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2",
    "firebase": "^12.14.0",
    "phaser": "^3.80.1",
    "pixi.js": "^8.20.1",
    "react": "^18.2.0",
    "react-colorful": "^5.7.0",
    "react-dom": "^18.2.0",
    "typescript": "^4.9.5"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.8"
  },
  "scripts": {
    "predev": "node scripts/write-build-info.mjs",
    "dev": "vite",
    "start": "npm run dev",
    "prebuild": "node scripts/write-build-info.mjs",
    "build": "vite build",
    "build:android": "node scripts/write-build-info.mjs && vite build --mode android",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "cap:sync": "npm run build && npx cap sync",
    "cap:sync:android": "npm run build:android && npx cap sync android",
    "release:android": "npm run cap:sync:android && echo 'Next: npm run cap:open:android → Build → Generate Signed Bundle (docs/ANDROID_SIGNING.md)'",
    "cap:open:android": "npx cap open android",
    "generate:cards": "node ../tools/generate-card-placeholders.mjs"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
