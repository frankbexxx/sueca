{
  "name": "sueca-frontend",
  "version": "0.1.0-beta",
  "private": true,
  "homepage": ".",
  "dependencies": {
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/preferences": "^6.0.3",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "REACT_APP_CARD_EXT=png REACT_APP_USE_LOCAL_AI_ONLY=true react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "build:android": "REACT_APP_USE_LOCAL_AI_ONLY=true REACT_APP_PLATFORM=android REACT_APP_CARD_EXT=png REACT_APP_MULTIPLAYER_ENABLED=false REACT_APP_ADS_ENABLED=false react-scripts build",
    "cap:sync": "npm run build && npx cap sync",
    "cap:sync:android": "npm run build:android && npx cap sync android",
    "release:android": "npm run cap:sync:android && echo 'Next: npm run cap:open:android → Build → Generate Signed Bundle (docs/ANDROID_SIGNING.md)'",
    "cap:open:android": "npx cap open android",
    "generate:cards": "node ../tools/generate-card-placeholders.mjs"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}


